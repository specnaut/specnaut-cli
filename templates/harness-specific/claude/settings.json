{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(gh release create *)",
      "Bash(gh release edit *--draft*)",
      "Bash(gh run rerun *)",
      "Bash(*release/tag.sh*)",
      "Bash(*release/release-github.sh*)",
      "Bash(*release/release-gitlab.sh*)",
      "Bash(gh release edit *)",
      "Bash(gh release upload *)",
      "Bash(glab release create *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.specnaut/hooks/protect-generated.sh\" claude",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.specnaut/hooks/guard-merge.sh\" claude",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.specnaut/hooks/guard-dispatch-model.sh\" claude",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.specnaut/hooks/approve-on-prompt.sh\" claude",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.specnaut/hooks/approve-on-prompt.sh\" claude",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.specnaut/hooks/log-subagent.sh\" start",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.specnaut/hooks/log-subagent.sh\" stop",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check-backlog-prereqs.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "specnaut-marketplace": {
      "source": {
        "source": "github",
        "repo": "specnaut/specnaut-cli",
        "ref": "v7.2.0",
        "path": "packaging/marketplace/.claude-plugin/marketplace.json"
      }
    }
  },
  "enabledPlugins": {
    "specnaut-cockpit@specnaut-marketplace": true
  }
}
