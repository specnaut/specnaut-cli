# Parse-time behaviour: every refusal parser.ts makes before a handler runs,
# and the argument shapes @std/cli parseArgs accepts.
# An unknown command, and number-like positionals (coerced to numbers).
specnaut bogus
specnaut 42
specnaut 0042
specnaut 1e3
# An unknown flag, alone and swallowing the next word.
specnaut --bogus
specnaut --bogus init
specnaut -x
# A flag after a positional, and the = form.
specnaut cloud bogus --api-url $CLOUD_URL
specnaut --ai=claude bogus
# Commands that need a subcommand.
specnaut cloud
specnaut gate
specnaut gate bogus
specnaut spec
specnaut spec bogus
# init refusals: unknown values, and a removed harness (exit 1).
specnaut init --ai bogus
specnaut init --ai windsurf
specnaut init --backlog bogus
specnaut init --scheme bogus
specnaut init --spec-backend bogus
specnaut upgrade --backlog bogus
# diff and reconcile argument refusals.
specnaut diff a.md b.md
specnaut reconcile
specnaut reconcile --status extra
specnaut reconcile --status --accept-upstream
specnaut reconcile a.md --accept-upstream --accept-current
specnaut reconcile --accept-upstream
specnaut reconcile a.md b.md --accept-current
# scan refusals: every one is parse-time, before the handler runs git.
specnaut scan extra
specnaut scan --format bogus
specnaut scan --top -1
specnaut scan --path ../x
specnaut scan --path /etc
# verify-scripts refusals: it takes no argument.
specnaut verify-scripts extra
specnaut verify-scripts a b
# sandbox refusals: a sub-command, one full commit id, and a command after --.
specnaut sandbox
specnaut sandbox bogus
specnaut sandbox probe extra
specnaut sandbox exec
specnaut sandbox exec abc -- make
specnaut sandbox exec 0123456789abcdef0123456789abcdef01234567
specnaut sandbox -- exec 0123456789abcdef0123456789abcdef01234567 make
specnaut sandbox exec 0123456789abcdef0123456789abcdef01234567 --toolchain rel -- make
# record-checkout refusals: it takes no argument.
specnaut record-checkout extra
specnaut record-checkout a b
# review refusals: a sub-command, gate takes nothing, start one source, end one full commit id.
specnaut review
specnaut review gate x
specnaut review start
specnaut review start a b
specnaut review end HEAD
