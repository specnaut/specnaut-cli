# reconcile <path>: both resolutions, and each refusal — no lock, a path the
# lock does not track, no staged copy, no project file.
cd project
specnaut reconcile a/one.md --accept-upstream
specnaut reconcile a/two.md --accept-current
specnaut reconcile c/untracked.md --accept-upstream
specnaut reconcile a/unstaged.md --accept-upstream
specnaut reconcile a/gone.md --accept-current
specnaut reconcile --status
cd $WORK
specnaut reconcile a/one.md --accept-upstream

