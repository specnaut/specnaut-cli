# spec pull/push against the Cloud stub. Linux only (excluded.go): both open
# the credential store.
# uses: cloud
cd local-specs
specnaut spec pull 7
cd $WORK/cloud-specs
specnaut spec pull
specnaut spec push 9 --api-url $CLOUD_URL
specnaut spec pull 7 --api-url $CLOUD_URL
specnaut spec push 7 --api-url $CLOUD_URL

-- local-specs/.specnaut/backlog-config.yml --
backend: cloud
api_url: ""
project_key: "WID"
-- cloud-specs/.specnaut/backlog-config.yml --
backend: cloud
api_url: ""
project_key: "WID"
-- cloud-specs/.specnaut/installed.lock --
version: 2
harness: claude
backlog_backend: cloud
version_scheme: semver
spec_backend: cloud
templates_version: 0.0.1
entries:
