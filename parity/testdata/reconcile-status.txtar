# reconcile --status: no project, an empty queue, three files across two
# directories plus a path holding `&`, and every refusal that hides a staged
# copy (not in the lock, no project file, no lock, a removed harness). Then a
# staged copy the store refuses to read (cli#765): a link to a project file, to
# a folder, out of the project and to nothing, each reported in `refused`,
# while an untracked link stays hidden and a plain copy stays pending. Run a
# second time from a link to that project: the refusals name the directory as
# getcwd reports it, every link resolved, never the $PWD the shell went through.
specnaut reconcile --status
cd project
specnaut reconcile --status
cd $WORK/no-lock
specnaut reconcile --status
cd $WORK/removed
specnaut reconcile --status
cd $WORK/empty-queue
specnaut reconcile --status
mkdir $WORK/linked/.specnaut/upgrade-staging/b
symlink $WORK/linked/.specnaut/upgrade-staging/a/tool -> ../../../src/tool.ts
symlink $WORK/linked/.specnaut/upgrade-staging/a/dir -> ../../../src
symlink $WORK/linked/.specnaut/upgrade-staging/b/out.md -> $WORK/outside.md
symlink $WORK/linked/.specnaut/upgrade-staging/b/dangling.md -> nowhere.md
symlink $WORK/linked/.specnaut/upgrade-staging/b/untracked -> ../../../src/tool.ts
cd $WORK/linked
specnaut reconcile --status
symlink $WORK/via -> linked
cd $WORK/via
specnaut reconcile --status

-- project/.specnaut/installed.lock --
