# record-checkout: a SessionStart hook's input on stdin takes the record and
# appends its path to CLAUDE_ENV_FILE; clear keeps it, taking none; an input
# that is not a hook's is refused. Compared TypeScript against TypeScript: the
# Go port answers "not ported" (excluded.go, PortedToGo). The record holds each
# file's inode, so it is checked here and removed before the tree is captured.
mkdir project
cd project
exec git init -q -b main
cp $WORK/AGENTS.md AGENTS.md
exec git add -A
exec git commit -q -m base
env CLAUDE_ENV_FILE=$WORK/env.sh
stdin $WORK/startup.json
specnaut record-checkout
exists .git/specnaut/session/session-1.json
grep 'export SPECNAUT_SESSION_RECORD=.*session-1.json' $WORK/env.sh
rm .git/specnaut
rm $WORK/env.sh
stdin $WORK/clear.json
specnaut record-checkout
! exists .git/specnaut/session/session-1.json
! exists $WORK/env.sh
stdin $WORK/not-a-hook.json
! specnaut record-checkout
# git's index holds each file's inode and nanosecond times: not this command's output.
rm .git/index

-- AGENTS.md --
rules
-- startup.json --
{"session_id":"session-1","source":"startup","hook_event_name":"SessionStart"}
-- clear.json --
{"session_id":"session-1","source":"clear","hook_event_name":"SessionStart"}
-- not-a-hook.json --
{"source":"startup"}
